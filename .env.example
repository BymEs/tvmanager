# Public HTTP port exposed by Docker Compose
TVMANAGER_HTTP_PORT=8080

# Application database
TVMANAGER_DATABASE_URL=sqlite+aiosqlite:///./data/tvmanager.db
TVMANAGER_SQL_ECHO=0

# Security: replace with a long random value in production
TVMANAGER_SECRET_KEY=change-this-to-a-long-random-secret
TVMANAGER_ACCESS_TOKEN_MINUTES=1440

# Application metadata
TVMANAGER_ENV=production
TVMANAGER_LOG_LEVEL=info
